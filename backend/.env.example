# Server
PORT=8000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000

# Auth Secrets (users can change these or keep defaults for local testing)
JWT_SECRET=supersecretjwtstringatleast10chars
JWT_REFRESH_SECRET=supersecretjwtrefreshstringatleast10chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Local Docker Network URLs

DATABASE_URL=postgresql://pulseuser:pulsepassword@postgres:5432/pulsewatch
REDIS_URL=redis://redis:6379

# Gemini AI (User provides their own free Google AI Studio key)
GEMINI_API_KEY=your_gemini_api_key_here
PRIMARY_GEMINI_MODEL=gemini-3.1-flash-lite
SECONDARY_GEMINI_MODEL=gemini-3.8-flash